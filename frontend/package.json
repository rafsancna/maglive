{
  "name": "@maglive/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run build -w @maglive/contracts",
    "dev": "next dev --port 3000",
    "prebuild": "npm run build -w @maglive/contracts",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "clean": "rimraf .next coverage"
  },
  "dependencies": {
    "@maglive/contracts": "*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  }
}
