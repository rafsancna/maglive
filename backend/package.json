{
  "name": "@maglive/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run build -w @maglive/contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @maglive/contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "admin:create": "npm run build -w @maglive/contracts && tsx src/scripts/createAdmin.ts",
    "e2e:server": "tsx src/scripts/e2eServer.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests vitest.config.ts",
    "pretest": "npm run build -w @maglive/contracts",
    "test": "vitest run",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@maglive/contracts": "*",
    "argon2": "^0.45.1",
    "busboy": "1.6.0",
    "cheerio": "^1.2.0",
    "connect-mongo": "^6.0.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "8.3.0",
    "mongoose": "9.9.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "yoastseo": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
