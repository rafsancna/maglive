NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/maglive?replicaSet=maglive-rs
MONGODB_TEST_URI=mongodb://localhost:27017/maglive_test?replicaSet=maglive-rs
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=local-session-secret-123456789012345678901234
PREVIEW_SIGNING_SECRET=local-preview-secret-123456789012345678901234
PREVIEW_EXCHANGE_SECRET=local-exchange-secret-123456789012345678901234
UPLOAD_ROOT=./uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:5000/uploads
MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=262144000
MAX_DOCUMENT_BYTES=52428800
NEXT_REVALIDATION_URL=http://localhost:3000/api/internal/revalidate
NEXT_REVALIDATION_SECRET=local-revalidation-secret-123456789012345678901234
TRUST_PROXY=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
LOGIN_RATE_LIMIT_MAX=5
ADMIN_MUTATION_RATE_LIMIT_MAX=120
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_UPDATE_EXISTING=false
